{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bluemap:web-performance-matrix:4",
  "title": "BlueMap formal web-performance matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "repetitions",
    "scheduleSeed",
    "traceSeed",
    "benchmarkGitRevision",
    "manifestSha256",
    "mapIds",
    "controls",
    "variants",
    "cases"
  ],
  "properties": {
    "formatVersion": {
      "const": 4
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1
    },
    "scheduleSeed": {
      "type": "string",
      "minLength": 1
    },
    "traceSeed": {
      "type": "string",
      "minLength": 1
    },
    "benchmarkGitRevision": {
      "$ref": "#/$defs/gitRevision"
    },
    "manifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "mapIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "controls": {
      "$ref": "#/$defs/controls"
    },
    "variants": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "imageDigest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "duration": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
    },
    "encoding": {
      "enum": [
        "gzip",
        "zstd",
        "deflate",
        "identity"
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "digest"
      ],
      "properties": {
        "kind": {
          "enum": [
            "container",
            "ephemeralContainer",
            "initContainer"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "digest": {
          "$ref": "#/$defs/imageDigest"
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warmupDuration",
        "measurementDuration",
        "cooldownSeconds",
        "minimumAchievedRateRatio",
        "preAllocatedVUs",
        "maxVUs",
        "completionProgress"
      ],
      "properties": {
        "warmupDuration": {
          "$ref": "#/$defs/duration"
        },
        "measurementDuration": {
          "$ref": "#/$defs/duration"
        },
        "cooldownSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "minimumAchievedRateRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "preAllocatedVUs": {
          "type": "integer",
          "minimum": 1
        },
        "maxVUs": {
          "type": "integer",
          "minimum": 1
        },
        "completionProgress": {
          "$ref": "#/$defs/completionProgress"
        }
      }
    },
    "completionProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windowSeconds",
        "startupAllowanceSeconds",
        "minimumCompletionFraction",
        "startTimeToleranceSeconds"
      ],
      "properties": {
        "windowSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "startupAllowanceSeconds": {
          "type": "number",
          "minimum": 0
        },
        "minimumCompletionFraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "startTimeToleranceSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contractMode",
        "implementation",
        "storageType",
        "databaseBackend",
        "replicaCount",
        "expectedImages",
        "expectedSanitizedConfigSha256",
        "expectedSanitizedRuntimeSpecSha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "contractMode": {
          "enum": [
            "enhanced",
            "legacy"
          ]
        },
        "implementation": {
          "enum": [
            "php",
            "java",
            "rust"
          ]
        },
        "storageType": {
          "enum": [
            "sql",
            "file"
          ]
        },
        "databaseBackend": {
          "enum": [
            "postgresql",
            "mariadb",
            "none"
          ]
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "expectedImages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/image"
          }
        },
        "expectedSanitizedConfigSha256": {
          "$ref": "#/$defs/sha256"
        },
        "expectedSanitizedRuntimeSpecSha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "storageType": {
                "const": "file"
              }
            },
            "required": [
              "storageType"
            ]
          },
          "then": {
            "properties": {
              "databaseBackend": {
                "const": "none"
              }
            }
          },
          "else": {
            "properties": {
              "databaseBackend": {
                "enum": [
                  "postgresql",
                  "mariadb"
                ]
              }
            }
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile",
        "rate",
        "viewers",
        "markerIntervalSeconds",
        "acceptEncoding",
        "storedEncoding",
        "overloadPolicy",
        "latencyP95Milliseconds",
        "latencyP99Milliseconds",
        "variants"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "profile": {
          "enum": [
            "static",
            "hot-tile",
            "random-tiles",
            "large-tile",
            "settings",
            "textures",
            "large-object",
            "missing-tile",
            "conditional",
            "live-viewers",
            "map-data-mixed",
            "browser-mixed"
          ]
        },
        "rate": {
          "type": "integer",
          "minimum": 1
        },
        "viewers": {
          "type": "integer",
          "minimum": 1
        },
        "markerIntervalSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "acceptEncoding": {
          "$ref": "#/$defs/encoding"
        },
        "storedEncoding": {
          "$ref": "#/$defs/encoding"
        },
        "overloadPolicy": {
          "enum": [
            "forbid",
            "allow-explicit"
          ]
        },
        "latencyP95Milliseconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "latencyP99Milliseconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "variants": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  }
}
