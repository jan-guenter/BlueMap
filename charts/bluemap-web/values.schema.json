{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "$ref": "#/definitions/image"
    },
    "service": {
      "$ref": "#/definitions/service"
    },
    "storage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "minLength": 1,
          "maxLength": 120
        },
        "type": {
          "enum": ["file", "sql"]
        },
        "compression": {
          "enum": ["none", "gzip", "deflate", "zstd", "lz4"]
        },
        "file": {
          "type": "object",
          "properties": {
            "root": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["root"]
        },
        "sql": {
          "type": "object",
          "properties": {
            "databaseType": {
              "enum": ["mariadb", "mysql", "postgresql", "sqlite"]
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "database": {
              "type": "string"
            },
            "connectionUrl": {
              "type": "string"
            },
            "maxConnections": {
              "type": "integer"
            },
            "properties": {
              "type": "object",
              "additionalProperties": {
                "type": ["string", "number", "integer", "boolean"]
              }
            },
            "credentials": {
              "type": "object",
              "properties": {
                "existingSecret": {
                  "type": "string"
                },
                "usernameKey": {
                  "$ref": "#/definitions/secretKey"
                },
                "passwordKey": {
                  "$ref": "#/definitions/secretKey"
                },
                "username": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                }
              },
              "required": [
                "existingSecret",
                "usernameKey",
                "passwordKey",
                "username",
                "password"
              ]
            },
            "driver": {
              "type": "object",
              "properties": {
                "className": {
                  "type": "string"
                },
                "existingConfigMap": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    }
                  },
                  "required": ["name", "key"]
                },
                "download": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string"
                    },
                    "image": {
                      "$ref": "#/definitions/image"
                    }
                  },
                  "required": ["url", "sha256", "image"]
                }
              },
              "required": ["className", "existingConfigMap", "download"]
            }
          },
          "required": [
            "databaseType",
            "host",
            "port",
            "database",
            "connectionUrl",
            "maxConnections",
            "properties",
            "credentials",
            "driver"
          ]
        }
      },
      "required": ["id", "type", "compression", "file", "sql"]
    },
    "config": {
      "$ref": "#/definitions/configSource"
    },
    "secretConfig": {
      "$ref": "#/definitions/configSource"
    },
    "phpFpm": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "tileCacheMaxAge": {
          "type": "integer",
          "minimum": 0
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "nginx": {
          "type": "object",
          "properties": {
            "image": {
              "$ref": "#/definitions/image"
            },
            "resources": {
              "type": "object"
            }
          },
          "required": ["image", "resources"]
        },
        "service": {
          "$ref": "#/definitions/service"
        },
        "ingress": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(/[A-Za-z0-9._-]+)*/maps$"
            },
            "pathType": {
              "enum": ["Exact", "Prefix", "ImplementationSpecific"]
            }
          },
          "required": ["path", "pathType"]
        }
      },
      "required": [
        "enabled",
        "replicaCount",
        "tileCacheMaxAge",
        "image",
        "nginx",
        "service",
        "ingress"
      ]
    }
  },
  "required": [
    "replicaCount",
    "image",
    "service",
    "storage",
    "config",
    "secretConfig",
    "phpFpm"
  ],
  "definitions": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "tag": {
          "type": "string"
        }
      },
      "required": ["repository", "pullPolicy", "tag"]
    },
    "service": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["port", "type"]
    },
    "secretKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "minLength": 1
    },
    "configSource": {
      "type": "object",
      "properties": {
        "existingConfigMap": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "items": {
          "type": "array"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": ["items", "files"]
    }
  }
}
