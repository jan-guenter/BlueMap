{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "shutdownGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "$ref": "#/definitions/image"
    },
    "deploymentLabels": {
      "$ref": "#/definitions/labels"
    },
    "webserver": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "implementation": {
          "enum": ["java", "rust"]
        },
        "rust": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "$ref": "#/definitions/image"
            },
            "config": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "shutdownGraceSeconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "runtimeShutdownSeconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "dependencyCheckSeconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "storageTimeoutSeconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxInFlightRequests": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1024
                },
                "maxObjectBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "tileCacheMaxAgeSeconds": {
                  "type": "integer",
                  "minimum": 0
                },
                "webapp": {
                  "$ref": "#/definitions/rustWebapp"
                }
              },
              "required": [
                "shutdownGraceSeconds",
                "runtimeShutdownSeconds",
                "dependencyCheckSeconds",
                "storageTimeoutSeconds",
                "maxInFlightRequests",
                "maxObjectBytes",
                "tileCacheMaxAgeSeconds",
                "webapp"
              ]
            },
            "maps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_]+$"
                  },
                  "sorting": {
                    "type": "integer"
                  }
                },
                "required": ["id", "sorting"]
              }
            },
            "databaseTls": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": ["disable", "required", "verify-ca", "verify-full"]
                },
                "ca": {
                  "$ref": "#/definitions/rustTlsCa"
                },
                "clientCertificate": {
                  "$ref": "#/definitions/rustTlsClient"
                }
              },
              "required": ["mode", "ca", "clientCertificate"]
            }
          },
          "required": ["image", "config", "maps", "databaseTls"]
        }
      },
      "required": ["implementation", "rust"]
    },
    "service": {
      "$ref": "#/definitions/service"
    },
    "storage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "minLength": 1,
          "maxLength": 120
        },
        "type": {
          "enum": ["file", "sql"]
        },
        "compression": {
          "enum": ["none", "gzip", "deflate", "zstd", "lz4"]
        },
        "file": {
          "type": "object",
          "properties": {
            "root": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["root"]
        },
        "sql": {
          "type": "object",
          "properties": {
            "databaseType": {
              "enum": ["mariadb", "mysql", "postgresql", "sqlite"]
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "database": {
              "type": "string"
            },
            "connectionUrl": {
              "type": "string"
            },
            "maxConnections": {
              "type": "integer",
              "minimum": 1
            },
            "connectTimeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "properties": {
              "type": "object",
              "additionalProperties": {
                "type": ["string", "number", "integer", "boolean"]
              }
            },
            "credentials": {
              "type": "object",
              "properties": {
                "existingSecret": {
                  "type": "string"
                },
                "usernameKey": {
                  "$ref": "#/definitions/secretKey"
                },
                "passwordKey": {
                  "$ref": "#/definitions/secretKey"
                },
                "username": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                }
              },
              "required": [
                "existingSecret",
                "usernameKey",
                "passwordKey",
                "username",
                "password"
              ]
            },
            "driver": {
              "type": "object",
              "properties": {
                "className": {
                  "type": "string"
                },
                "existingConfigMap": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    }
                  },
                  "required": ["name", "key"]
                },
                "download": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string"
                    },
                    "image": {
                      "$ref": "#/definitions/image"
                    }
                  },
                  "required": ["url", "sha256", "image"]
                }
              },
              "required": ["className", "existingConfigMap", "download"]
            }
          },
          "required": [
            "databaseType",
            "host",
            "port",
            "database",
            "connectionUrl",
            "maxConnections",
            "connectTimeoutSeconds",
            "properties",
            "credentials",
            "driver"
          ]
        }
      },
      "required": ["id", "type", "compression", "file", "sql"]
    },
    "config": {
      "$ref": "#/definitions/configSource"
    },
    "secretConfig": {
      "$ref": "#/definitions/configSource"
    },
    "phpFpm": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "strategy": {
          "type": "object"
        },
        "maxChildren": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "deploymentLabels": {
          "$ref": "#/definitions/labels"
        },
        "nginx": {
          "type": "object",
          "properties": {
            "image": {
              "$ref": "#/definitions/image"
            },
            "resources": {
              "type": "object"
            }
          },
          "required": ["image", "resources"]
        },
        "service": {
          "$ref": "#/definitions/service"
        },
        "ingress": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(/[A-Za-z0-9._-]+)*/maps$"
            },
            "pathType": {
              "enum": ["Exact", "Prefix", "ImplementationSpecific"]
            }
          },
          "required": ["path", "pathType"]
        }
      },
      "required": [
        "enabled",
        "replicaCount",
        "strategy",
        "maxChildren",
        "image",
        "deploymentLabels",
        "nginx",
        "service",
        "ingress"
      ]
    }
  },
  "required": [
    "replicaCount",
    "terminationGracePeriodSeconds",
    "shutdownGracePeriodSeconds",
    "image",
    "deploymentLabels",
    "webserver",
    "service",
    "storage",
    "config",
    "secretConfig",
    "phpFpm"
  ],
  "definitions": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "tag": {
          "type": "string"
        }
      },
      "required": ["repository", "pullPolicy", "tag"]
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["port", "type"]
    },
    "rustWebapp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "useCookies": {
          "type": "boolean"
        },
        "defaultToFlatView": {
          "type": "boolean"
        },
        "startLocation": {
          "type": "string"
        },
        "resolutionDefault": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minZoomDistance": {
          "type": "integer"
        },
        "maxZoomDistance": {
          "type": "integer"
        },
        "hiresSliderMax": {
          "type": "integer"
        },
        "hiresSliderDefault": {
          "type": "integer"
        },
        "hiresSliderMin": {
          "type": "integer"
        },
        "lowresSliderMax": {
          "type": "integer"
        },
        "lowresSliderDefault": {
          "type": "integer"
        },
        "lowresSliderMin": {
          "type": "integer"
        },
        "mapDataRoot": {
          "type": "string",
          "minLength": 1
        },
        "liveDataRoot": {
          "type": "string",
          "minLength": 1
        },
        "scripts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "styles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "useCookies",
        "defaultToFlatView",
        "startLocation",
        "resolutionDefault",
        "minZoomDistance",
        "maxZoomDistance",
        "hiresSliderMax",
        "hiresSliderDefault",
        "hiresSliderMin",
        "lowresSliderMax",
        "lowresSliderDefault",
        "lowresSliderMin",
        "mapDataRoot",
        "liveDataRoot",
        "scripts",
        "styles"
      ]
    },
    "rustTlsCa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "key": {
          "$ref": "#/definitions/secretKey"
        }
      },
      "required": ["existingSecret", "key"]
    },
    "rustTlsClient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "certKey": {
          "$ref": "#/definitions/secretKey"
        },
        "keyKey": {
          "$ref": "#/definitions/secretKey"
        }
      },
      "required": ["existingSecret", "certKey", "keyKey"]
    },
    "secretKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "minLength": 1
    },
    "configSource": {
      "type": "object",
      "properties": {
        "existingConfigMap": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "items": {
          "type": "array"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": ["items", "files"]
    }
  }
}
